# Production defaults to /api, which should be routed to Spring by the reverse proxy.
# Set this only when the API is hosted on a separate HTTPS origin.
VITE_API_BASE_URL=/api

# Local Vite proxy target. Set VITE_DEV_API_SECURE=false only for a local
# self-signed development certificate.
VITE_DEV_API_TARGET=https://localhost:8080
VITE_DEV_API_SECURE=false
